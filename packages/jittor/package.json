{
  "name": "@danypops/jittor",
  "version": "0.19.1",
  "description": "Just-in-Time Token Optimization Router for Pi -- token and context observability with optimization policies",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "keywords": ["llm-router", "token-budget"],
  "bin": {
    "jittor": "src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "serve": "bun src/cli.ts serve",
    "service:install": "bun src/cli.ts service install"
  },
  "packed": {
    "daemonService": {
      "name": "jittor",
      "displayName": "Jittor",
      "binPath": "src/cli.ts",
      "args": ["serve"],
      "handleFilename": "daemon.json",
      "restartOnFailure": true,
      "restartSec": 2
    }
  },
  "dependencies": {
    "@danypops/vehicle-core": "^0.17.1",
    "@danypops/vehicle-server": "^0.24.5",
    "@danypops/vehicle-client": "^0.10.1",
    "google-auth-library": "^10.9.0",
    "gpt-tokenizer": "^3.4.0"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanyPops/jittor.git",
    "directory": "packages/jittor"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["src", "docs", "README.md"]
}
