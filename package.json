{
  "name": "jittor-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "keywords": ["pi-package"],
  "scripts": {
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "serve": "bun --cwd packages/jittor src/cli.ts serve",
    "service:install": "bun --cwd packages/jittor src/cli.ts service install",
    "guard:install": "git config core.hooksPath .githooks"
  },
  "pi": {
    "extensions": ["packages/pi-jittor/extension/src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanyPops/jittor.git"
  }
}
